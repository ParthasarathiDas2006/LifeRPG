// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AttributeType {
  INTEGRITY
  COMPASSION
  DISCIPLINE
  WISDOM
  STRENGTH
  INTELLIGENCE
  VITALITY
  AGILITY
  CHARISMA
  WILLPOWER
}

enum TaskType {
  DAILY
  HABIT
  TODO
  NEGATIVE_RESTRAINT // "No Anger Day", "Digital Fasting" (settled via reflection)
  REFLECTION         // Evening introspection / gratitude journal
  BOSS_RAID
  MILESTONE
}

enum TaskDifficulty {
  TRIVIAL
  EASY
  MEDIUM
  HARD
  EPIC
}

enum RewardCategory {
  THEME
  BADGE
  TITLE
  AVATAR_AURA
}

model User {
  id                  String           @id @default(uuid())
  supabaseId          String?          @unique @map("supabase_id")
  email               String           @unique
  username            String           @unique
  level               Int              @default(1)
  currentXp           Int              @default(0) @map("current_xp")
  totalXp             Int              @default(0) @map("total_xp")
  gold                Int              @default(100)
  virtueCoins         Int              @default(25) @map("virtue_coins")
  activeTheme         String           @default("sanctuary_dawn") @map("active_theme")
  streakFreezeTokens  Int              @default(2) @map("streak_freeze_tokens")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  attributes          UserAttribute[]
  tasks               Task[]
  taskLogs            TaskLog[]
  userRewards         UserReward[]
  userBadges          UserBadge[]

  @@map("users")
}

model UserAttribute {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  attribute     AttributeType
  level         Int           @default(1)
  currentXp     Int           @default(0) @map("current_xp")
  totalPoints   Int           @default(0) @map("total_points")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attribute])
  @@map("user_attributes")
}

model Task {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  title              String
  description        String?
  attribute          AttributeType
  difficulty         TaskDifficulty  @default(MEDIUM)
  type               TaskType        @default(DAILY)
  baseXp             Int             @default(25) @map("base_xp")
  baseGold           Int             @default(10) @map("base_gold")
  baseVirtueCoins    Int             @default(5) @map("base_virtue_coins")
  currentStreak      Int             @default(0) @map("current_streak")
  longestStreak      Int             @default(0) @map("longest_streak")
  requiresReflection Boolean         @default(false) @map("requires_reflection")
  lastCompletedAt    DateTime?       @map("last_completed_at")
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs               TaskLog[]

  @@index([userId, isActive])
  @@map("tasks")
}

model TaskLog {
  id                 String          @id @default(uuid())
  taskId             String          @map("task_id")
  userId             String          @map("user_id")
  xpEarned           Int             @map("xp_earned")
  goldEarned         Int             @default(0) @map("gold_earned")
  virtueCoinsEarned  Int             @default(0) @map("virtue_coins_earned")
  streakCount        Int             @map("streak_count")
  reflectionText     String?         @db.Text @map("reflection_text")
  moodRating         Int?            @map("mood_rating") // 1-5 scale
  honestyAffirmed    Boolean         @default(true) @map("honesty_affirmed")
  completedAt        DateTime        @default(now()) @map("completed_at")

  task               Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("task_logs")
}

model Reward {
  id                 String          @id @default(uuid())
  title              String
  description        String
  costCoins          Int             @default(50) @map("cost_coins")
  category           RewardCategory
  assetKey           String          @map("asset_key")
  minLevel           Int             @default(1) @map("min_level")

  userRewards        UserReward[]

  @@map("rewards")
}

model UserReward {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  rewardId           String          @map("reward_id")
  isEquipped         Boolean         @default(false) @map("is_equipped")
  unlockedAt         DateTime        @default(now()) @map("unlocked_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward             Reward          @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
  @@map("user_rewards")
}

model Badge {
  id                 String          @id @default(uuid())
  code               String          @unique
  title              String
  description        String
  iconUrl            String          @map("icon_url")
  attribute          AttributeType?

  userBadges         UserBadge[]

  @@map("badges")
}

model UserBadge {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  badgeId            String          @map("badge_id")
  unlockedAt         DateTime        @default(now()) @map("unlocked_at")

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge              Badge           @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}
